# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=RingRiot
# Long random string used to sign the free-demo cookie (openssl rand -hex 32)
DEMO_COOKIE_SECRET=

# ---------- Supabase (auth + database) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose. Used by the Stripe webhook to write credits.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- AI text provider ----------
# "anthropic" (recommended) or "scripted" (no key needed; built-in lines, clearly labeled)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Your cost per million tokens from the provider's current pricing page (used for margin tracking)
AI_COST_PER_MTOK_INPUT=1.00
AI_COST_PER_MTOK_OUTPUT=5.00

# ---------- Voice (optional; browser voices are used when blank) ----------
# "browser" (free, on-device) or "elevenlabs"
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Your cost per 1,000 characters from ElevenLabs' current pricing page
TTS_COST_PER_1K_CHARS=0.10

# ---------- Stripe (use TEST keys until verified) ----------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Created in your Stripe sandbox ("New business sandbox"), test mode:
STRIPE_PRICE_PLUS=price_1USHt7KTWyAE5acuF4jA9jJ1
STRIPE_PRICE_PRO=price_1USHt8KTWyAE5acu2VW0sAi8
STRIPE_PRICE_CREDITS_25=price_1USHt9KTWyAE5acurqXvkb5l

# ---------- Admin ----------
# Comma-separated emails allowed into /admin
ADMIN_EMAILS=
